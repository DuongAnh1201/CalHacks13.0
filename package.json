{
  "name": "neurovision-convex-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Convex collaborative backend for NeuroVision / NeuroLens Live Review (see docs/CONVEX_BACKEND.md)",
  "scripts": {
    "codegen": "convex codegen",
    "dev": "convex dev",
    "deploy": "static-hosting deploy --dist frontend/dist --build-command \"npm --prefix frontend run build\"",
    "typecheck": "tsc --noEmit -p convex",
    "test": "vitest run",
    "test:watch": "vitest",
    "test-harness:build": "esbuild test-harness/app.js --bundle --format=esm --platform=browser --outfile=test-harness/dist/app.js",
    "test-harness": "npm run test-harness:build && node test-harness/serve.mjs"
  },
  "dependencies": {
    "@convex-dev/static-hosting": "^0.2.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "convex": "^1.48.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "convex-test": "^0.0.65",
    "esbuild": "^0.27.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild@0.27.0": true
  }
}
