{
  /* TypeScript config for the Convex backend.
   *
   * This file was generated by the Convex CLI and is the config the CLI itself
   * uses to typecheck on every push (`npx convex dev`). `npm run typecheck`
   * points at it too, so there is exactly ONE config describing this directory
   * and an editor cannot disagree with CI about what is an error.
   *
   * `tsc --noEmit -p convex` is the closest thing this project has to
   * `mvn compile`: it never emits JavaScript (Convex bundles the sources itself
   * with esbuild), it only reports type errors.
   *
   * When teammates add the Vite React app it gets its OWN tsconfig under
   * `frontend/`, because the two have genuinely different needs — the browser
   * build needs DOM libs and JSX, the Convex runtime does not.
   * See docs/CONVEX_BACKEND.md §8.
   */
  "compilerOptions": {
    /* These settings are not required by Convex and can be modified. */
    "allowJs": true,

    /* All strict checks on. The most valuable one here is `strictNullChecks`:
     * `ctx.db.get()` returns `T | null`, and strict mode is what forces every
     * call site to handle the null instead of discovering it during a demo. */
    "strict": true,

    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,

    /* --- Added beyond the Convex defaults --- */

    /* Catch an import or a local that stopped being used, which is how dead
     * code accumulates in a file nobody reads top-to-bottom any more. */
    "noUnusedLocals": true,
    "noUnusedParameters": false,

    /* `lib/viewCommands.ts` switches exhaustively over a command union, so a
     * missing `break`/`return` would silently apply two commands at once. */
    "noFallthroughCasesInSwitch": true,

    /* These compiler options are required by Convex */
    "target": "ESNext",
    "lib": ["ES2023", "dom"],
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["./**/*"],
  /* `_generated` is machine-written and already type-correct; checking it only
   * slows the build down. It is still COMMITTED to the repo — see
   * docs/CONVEX_BACKEND.md §2.3. */
  "exclude": ["./_generated"]
}
